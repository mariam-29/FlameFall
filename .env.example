# FlameFall backend environment variables
# Copy to .env for local development. Vercel variables are optional unless noted.

# Local Express listener only; Vercel supplies its own request handling (default: 4000).
PORT=4000

# Optional: enables live AI on POST /api/explain. If unset, the reviewed deterministic
# fallback is used. Use GEMINI_API_KEY or its legacy alias AI_API_KEY, not both.
GEMINI_API_KEY=

# Optional; defaults to gemini-3.1-flash-lite.
GEMINI_MODEL=gemini-3.1-flash-lite

# Optional; force reviewed fallback even when an API key is set (default: false).
FORCE_FALLBACK_MODE=false

# Optional; AI timeout in milliseconds (default: 12000).
# AI_TIMEOUT_MS=12000

# Optional per-instance /api/explain request cap (default: disabled).
# These in-memory limits are per serverless instance, not a global shared limit.
# PUBLIC_RATE_LIMIT_MAX=10
# PUBLIC_RATE_LIMIT_WINDOW_MS=60000
