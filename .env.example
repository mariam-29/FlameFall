# ============================================================================
# Flame Trace (Flame in Freefall) — Backend Environment Configuration
# Copy this file to `.env` for local development or production deployment.
# ============================================================================

# Express HTTP Server Port (default: 4000)
PORT=4000

# Google Gemini API Configuration (Optional — enables live_ai mode on POST /api/explain)
# When omitted or empty, /api/explain automatically serves deterministic reviewed_fallback
# synthesis with zero downtime.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Force deterministic fallback mode even when GEMINI_API_KEY is set ("true" | "false")
FORCE_FALLBACK_MODE=false

# Serverless-compatible sliding-window rate limits for /api/explain (per 10-minute window)
PUBLIC_RATE_LIMIT_MAX=10
TEAM_PASSCODE=
TEAM_RATE_LIMIT_MAX=60
