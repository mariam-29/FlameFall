{
  "name": "flame-trace-backend",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "description": "NASA Space Apps 2026 — Flame Trace (Flame in Freefall) Node.js + Express Scientific Backend",
  "scripts": {
    "build:data": "python scripts/build_data.py",
    "dev": "npm run build:data && tsx watch src/server.ts",
    "build": "npm run build:data && tsc -p tsconfig.build.json",
    "build:vercel": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "npm run build:data && vitest run",
    "verify:all": "npm run build:data && npm run typecheck && vitest run && npm run build"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.9.0",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
